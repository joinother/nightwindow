[Unit]
Description=Night Window weather proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nightwindow
Group=nightwindow
WorkingDirectory=/opt/nightwindow-api
EnvironmentFile=/etc/nightwindow-api.env
ExecStart=/usr/bin/node /opt/nightwindow-api/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=nightwindow
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
